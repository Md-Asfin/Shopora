# Root .gitignore for Shopora Project

# Maven build artifacts
**/target/
*.class

# Node / Frontend
**/node_modules/
**/dist/
**/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and Secret configuration
**/.env
**/.env.*
!**/.env.example
**/application-local.properties
!**/application-local.properties.example

# IDE files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
